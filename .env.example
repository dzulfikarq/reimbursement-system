# Copy to `.env` before running docker compose. All values have safe dev
# defaults; never commit a real `.env`.

APP_ENV=development
FRONTEND_URL=http://localhost:5173
MIGRATE_ON_START=true

PORT=8080

DB_HOST=postgres
DB_PORT=5432
DB_USER=reimbursement
DB_PASSWORD=reimbursement
DB_NAME=reimbursement
DB_SSLMODE=disable

REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=receipts
MINIO_USE_SSL=false
