# Copy to `.env` before running docker compose. All values have safe dev
# defaults; never commit a real `.env`.

APP_ENV=development
FRONTEND_URL=http://localhost:5173
MIGRATE_ON_START=true

# Signs JWTs and CSRF cookies. MUST be a long random value in production.
APP_SECRET=dev-only-secret-change-me
# Set true only when serving over HTTPS (controls cookie Secure flag).
COOKIE_SECURE=false

PORT=8080

DB_HOST=postgres
DB_PORT=5432
DB_USER=reimbursement
DB_PASSWORD=reimbursement
DB_NAME=reimbursement
DB_SSLMODE=disable

REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

MINIO_ENDPOINT=minio:9000
# Host browsers use for presigned download URLs. In docker, set this to
# localhost:9000 (the published port); defaults to MINIO_ENDPOINT.
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=receipts
MINIO_USE_SSL=false
